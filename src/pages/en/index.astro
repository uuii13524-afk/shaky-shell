---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Auto-collect articles (new posts appear automatically)
const modules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(modules)
  .map((m) => {
    const fm = m.frontmatter ?? {};
    return {
      url: m.url,
      title: fm.title ?? '(untitled)',
      date: fm.date ?? '',
      category: fm.category ?? '',
      description: fm.description ?? '',
    };
  })
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));

const tools = [
  { href: '/json-formatter', name: 'JSON Formatter', desc: 'Format and validate JSON' },
  { href: '/base64', name: 'Base64 Encoder / Decoder', desc: 'Encode and decode Base64' },
  { href: '/regex-tester', name: 'Regex Tester', desc: 'Test regular expressions in real time' },
  { href: '/jwt-decoder', name: 'JWT Decoder', desc: 'Decode JWT tokens in the browser' },
  { href: '/timestamp', name: 'Timestamp Converter', desc: 'Unix timestamp ↔ datetime' },
  { href: '/cron-checker', name: 'Cron Checker', desc: 'Parse cron expressions and preview runs' },
];
---
<BaseLayout
  title="ErrNotes — Real Error Logs & Dev Tools"
  description="A collection of real, reproduced-and-fixed error logs for developers. Docker, Linux, Git, GitHub Actions, Cloudflare, nginx — plus browser-based developer tools."
  lang="en"
  altUrl="/"
>
  <div class="hero">
    <h1>Err<span>Notes</span></h1>
    <p class="lead">Real error logs — reproduced, fixed, and written down for developers.</p>
    <p class="tagline">Docker · Linux · Git · GitHub Actions · Cloudflare · nginx</p>
  </div>

  <div class="search-section">
    <form class="search-form" action="/en/search" method="get">
      <input type="search" name="q" placeholder="Search articles…" class="search-input" autocomplete="off" />
      <button type="submit" class="search-btn">Search</button>
    </form>
  </div>

  <div class="section-title">Tools</div>
  <div class="tools-grid">
    {tools.map((tool) => (
      <a href={tool.href} class="tool-card">
        <div class="tool-name">{tool.name}</div>
        <div class="tool-desc">{tool.desc}</div>
      </a>
    ))}
  </div>

  <div class="section-title">Articles ({posts.length})</div>
  <ul class="article-list">
    {posts.map((post) => (
      <li class="article-item">
        <a href={post.url} class="article-link">
          {post.category && <span class="category-badge">{post.category}</span>}
          <div class="article-title">{post.title}</div>
          {post.description && <div class="article-desc">{post.description}</div>}
          <div class="article-meta">
            <span class="article-date">{post.date}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
