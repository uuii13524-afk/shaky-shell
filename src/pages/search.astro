---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="記事検索">
  <h1>記事検索</h1>
  <div id="search"></div>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({ element: '#search', showImages: false });
    });
  </script>
</BaseLayout>
