---
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Base64 Encoder / Decoder - ErrNotes</title>
    <meta name="description" content="テキストをBase64にエンコード・デコードできる無料ツール。APIトークンや設定ファイルの確認に使えます。" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">Err<span>Notes</span></a>
        <nav class="site-nav">
          <a href="/">記事</a>
          <a href="/base64">Base64</a>
          <a href="/json-formatter">JSON</a>
        </nav>
      </div>
    </header>
    <main class="site-wrapper tool-page">
      <h2>Base64 Encoder / Decoder</h2>
      <p class="tool-desc">テキストをBase64形式にエンコード・デコードできます。APIトークンや設定ファイルの確認に使えます。</p>

      <div style="margin-bottom:16px;">
        <label style="font-size:13px;color:var(--text2);display:block;margin-bottom:6px;">入力テキスト</label>
        <textarea id="input" style="height:120px;" placeholder="ここにテキストを入力してください"></textarea>
        <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
          <button class="btn btn-primary" id="encodeBtn">エンコード（Base64に変換）</button>
          <button class="btn btn-primary" id="decodeBtn">デコード（Base64から変換）</button>
          <button class="btn btn-secondary" id="clearBtn">クリア</button>
        </div>
      </div>

      <div>
        <label style="font-size:13px;color:var(--text2);display:block;margin-bottom:6px;">結果</label>
        <div class="result-box" id="result">結果がここに表示されます</div>
        <div id="error" style="color:var(--danger);font-size:12px;font-family:var(--mono);margin-top:6px;"></div>
        <div style="margin-top:10px;">
          <button class="btn btn-success" id="copyBtn">コピー</button>
        </div>
      </div>

      <div style="margin-top:48px;padding-top:24px;border-top:1px solid var(--border);">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text2);margin-bottom:14px;">その他のツール</div>
        <ul style="list-style:none;">
          <li style="padding:6px 0;border-bottom:1px solid var(--border);"><a href="/json-formatter" style="font-size:13px;color:var(--text);">JSON Formatter / Validator</a></li>
        </ul>
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-wrapper">
        <a href="/">← 記事一覧に戻る</a>
        &nbsp;·&nbsp;
        <a href="/privacy">プライバシーポリシー</a>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('encodeBtn').addEventListener('click', function() {
        var input = document.getElementById('input').value;
        document.getElementById('error').textContent = '';
        if (!input) { document.getElementById('result').textContent = '入力テキストを入力してください'; return; }
        try {
          document.getElementById('result').textContent = btoa(unescape(encodeURIComponent(input)));
        } catch(e) {
          document.getElementById('error').textContent = 'エンコードに失敗しました: ' + e.message;
        }
      });
      document.getElementById('decodeBtn').addEventListener('click', function() {
        var input = document.getElementById('input').value;
        document.getElementById('error').textContent = '';
        if (!input) { document.getElementById('result').textContent = '入力テキストを入力してください'; return; }
        try {
          document.getElementById('result').textContent = decodeURIComponent(escape(atob(input)));
        } catch(e) {
          document.getElementById('error').textContent = 'デコードに失敗しました。正しいBase64文字列を入力してください。';
        }
      });
      document.getElementById('clearBtn').addEventListener('click', function() {
        document.getElementById('input').value = '';
        document.getElementById('result').textContent = '結果がここに表示されます';
        document.getElementById('error').textContent = '';
      });
      document.getElementById('copyBtn').addEventListener('click', function() {
        navigator.clipboard.writeText(document.getElementById('result').textContent).then(function() {
          var btn = document.getElementById('copyBtn');
          btn.textContent = 'コピーしました！';
          setTimeout(function() { btn.textContent = 'コピー'; }, 2000);
        });
      });
    </script>
  </body>
</html>
