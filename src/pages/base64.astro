---
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Base64 Encoder / Decoder - ErrNotes</title>
    <meta name="description" content="Free Base64 encoder and decoder. テキストをBase64にエンコード・デコードできる無料ツール。" />
    <link rel="stylesheet" href="/styles/global.css" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3348501480039832" crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">Err<span>Notes</span></a>
        <nav class="site-nav">
          <a href="/">記事</a>
          <a href="/base64">Base64</a>
          <a href="/json-formatter">JSON</a>
          <a href="/regex-tester">RegEx</a>
          <a href="/jwt-decoder">JWT</a>
          <a href="/cron-checker">Cron</a>
          <a href="/en">English</a>
        </nav>
      </div>
    </header>
    <main class="site-wrapper tool-page">
      <h2>Base64 Encoder / Decoder</h2>
      <p class="tool-desc">
        テキストをBase64形式にエンコード・デコードできます。APIトークンや設定ファイルの確認に使えます。<br>
        <span style="color:var(--text2);font-size:12px;">Encode and decode text to/from Base64. Useful for API tokens and config files.</span>
      </p>

      <div style="margin-bottom:16px;">
        <label style="font-size:13px;color:var(--text2);display:block;margin-bottom:6px;">入力テキスト / Input text</label>
        <textarea id="input" style="height:120px;" placeholder="Enter text here / ここにテキストを入力"></textarea>
        <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
          <button class="btn btn-primary" id="encodeBtn">Encode（Base64に変換）</button>
          <button class="btn btn-primary" id="decodeBtn">Decode（Base64から変換）</button>
          <button class="btn btn-secondary" id="clearBtn">Clear / クリア</button>
        </div>
      </div>

      <div>
        <label style="font-size:13px;color:var(--text2);display:block;margin-bottom:6px;">Result / 結果</label>
        <div class="result-box" id="result">Result will appear here / 結果がここに表示されます</div>
        <div id="error" style="color:var(--danger);font-size:12px;font-family:var(--mono);margin-top:6px;"></div>
        <div style="margin-top:10px;">
          <button class="btn btn-success" id="copyBtn">Copy / コピー</button>
        </div>
      </div>

      <div style="margin-top:48px;padding-top:24px;border-top:1px solid var(--border);">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text2);margin-bottom:14px;">Other Tools / その他のツール</div>
        <ul style="list-style:none;">
          <li style="padding:6px 0;border-bottom:1px solid var(--border);"><a href="/json-formatter" style="font-size:13px;color:var(--text);">JSON Formatter / Validator</a></li>
          <li style="padding:6px 0;border-bottom:1px solid var(--border);"><a href="/timestamp" style="font-size:13px;color:var(--text);">Timestamp Converter / タイムスタンプ変換</a></li>
          <li style="padding:6px 0;border-bottom:1px solid var(--border);"><a href="/regex-tester" style="font-size:13px;color:var(--text);">Regex Tester / 正規表現テスター</a></li>
          <li style="padding:6px 0;border-bottom:1px solid var(--border);"><a href="/jwt-decoder" style="font-size:13px;color:var(--text);">JWT Decoder / JWTデコーダー</a></li>
          <li style="padding:6px 0;border-bottom:1px solid var(--border);"><a href="/cron-checker" style="font-size:13px;color:var(--text);">Cron Checker / Cron式チェッカー</a></li>
        </ul>
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-wrapper">
        <a href="/privacy">プライバシーポリシー</a>
        <a href="https://bsky.app/profile/sasukkun.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('encodeBtn').addEventListener('click', function() {
        var input = document.getElementById('input').value;
        document.getElementById('error').textContent = '';
        if (!input) { document.getElementById('result').textContent = 'Enter text first / テキストを入力してください'; return; }
        try {
          document.getElementById('result').textContent = btoa(unescape(encodeURIComponent(input)));
        } catch(e) {
          document.getElementById('error').textContent = 'Error: ' + e.message;
        }
      });
      document.getElementById('decodeBtn').addEventListener('click', function() {
        var input = document.getElementById('input').value;
        document.getElementById('error').textContent = '';
        if (!input) { document.getElementById('result').textContent = 'Enter text first / テキストを入力してください'; return; }
        try {
          document.getElementById('result').textContent = decodeURIComponent(escape(atob(input)));
        } catch(e) {
          document.getElementById('error').textContent = 'Invalid Base64 string / 正しいBase64文字列を入力してください';
        }
      });
      document.getElementById('clearBtn').addEventListener('click', function() {
        document.getElementById('input').value = '';
        document.getElementById('result').textContent = 'Result will appear here / 結果がここに表示されます';
        document.getElementById('error').textContent = '';
      });
      document.getElementById('copyBtn').addEventListener('click', function() {
        navigator.clipboard.writeText(document.getElementById('result').textContent).then(function() {
          var btn = document.getElementById('copyBtn');
          btn.textContent = 'Copied! / コピーしました';
          setTimeout(function() { btn.textContent = 'Copy / コピー'; }, 2000);
        });
      });
    </script>
  </body>
</html>
