---
import BaseLayout from '../layouts/BaseLayout.astro';

// 記事を自動収集（投稿すれば自動で一覧へ反映される）
const modules = import.meta.glob('./posts/*.md', { eager: true });
const posts = Object.values(modules)
  .map((m) => {
    const fm = m.frontmatter ?? {};
    return {
      url: m.url,
      title: fm.title ?? '(untitled)',
      date: fm.date ?? '',
      category: fm.category ?? '',
      description: fm.description ?? '',
    };
  })
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));

const tools = [
  { href: '/json-formatter', name: 'JSON Formatter', desc: 'JSONを整形・バリデーション' },
  { href: '/base64', name: 'Base64 Encoder / Decoder', desc: 'テキストをBase64に変換' },
  { href: '/regex-tester', name: 'Regex Tester', desc: '正規表現をリアルタイムでテスト' },
  { href: '/jwt-decoder', name: 'JWT Decoder', desc: 'JWTトークンをブラウザ内でデコード' },
  { href: '/timestamp', name: 'Timestamp変換', desc: 'Unixタイムスタンプ ↔ 日時' },
  { href: '/cron-checker', name: 'Cron Checker', desc: 'Cron式を解析・次回実行時刻を確認' },
];
---
<BaseLayout
  title="ErrNotes — エラー解決ログ & 開発ツール"
  description="実際に詰まったエラーの記録と解決ログ。Docker・Linux・GitHub Actions・Cloudflare・nginx など開発現場のリアルなトラブルシューティング集と、ブラウザ完結の開発ツール。"
  lang="ja"
  altUrl="/en"
>
  <div class="hero">
    <h1>Err<span>Notes</span></h1>
    <p class="lead">実際に詰まったエラーを再現して直した、開発現場のリアルな解決ログ。</p>
    <p class="tagline">Docker · Linux · Git · GitHub Actions · Cloudflare · nginx</p>
  </div>

  <div class="search-section">
    <form class="search-form" action="/search" method="get">
      <input type="search" name="q" placeholder="記事を検索…" class="search-input" autocomplete="off" />
      <button type="submit" class="search-btn">検索</button>
    </form>
  </div>

  <div class="section-title">ツール</div>
  <div class="tools-grid">
    {tools.map((tool) => (
      <a href={tool.href} class="tool-card">
        <div class="tool-name">{tool.name}</div>
        <div class="tool-desc">{tool.desc}</div>
      </a>
    ))}
  </div>

  <div class="section-title">記事一覧（{posts.length}）</div>
  <ul class="article-list">
    {posts.map((post) => (
      <li class="article-item">
        <a href={post.url} class="article-link">
          {post.category && <span class="category-badge">{post.category}</span>}
          <div class="article-title">{post.title}</div>
          {post.description && <div class="article-desc">{post.description}</div>}
          <div class="article-meta">
            <span class="article-date">{post.date}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
