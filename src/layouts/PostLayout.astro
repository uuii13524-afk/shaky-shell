---
const { frontmatter } = Astro.props;
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} - ErrNotes</title>
    <meta name="description" content={frontmatter.title + ' - ErrNotesの技術解決ログ'} />
    <link rel="stylesheet" href="/styles/global.css" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3348501480039832" crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">Err<span>Notes</span></a>
        <nav class="site-nav">
          <a href="/">記事</a>
          <a href="/base64">Base64</a>
          <a href="/json-formatter">JSON</a>
          <a href="/regex-tester">RegEx</a>
          <a href="/jwt-decoder">JWT</a>
          <a href="/cron-checker">Cron</a>
          <a href="/en">English</a>
        </nav>
      </div>
    </header>
    <main class="site-wrapper">
      <article>
        <div class="article-header">
          <div class="category">{frontmatter.category}</div>
          <h1>{frontmatter.title}</h1>
          <div class="meta">{frontmatter.date}</div>
        </div>
        <div class="article-body">
          <slot />
        </div>
      </article>
    </main>
    <footer class="site-footer">
      <div class="site-wrapper">
        <a href="/">← 記事一覧に戻る</a>
        &nbsp;·&nbsp;
        <a href="/privacy">プライバシーポリシー</a>
        &nbsp;·&nbsp;
        <a href="https://bsky.app/profile/sasukkun.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>
      </div>
    </footer>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
    <script src="/pagefind/pagefind-ui.js"></script>
    <div id="search"></div>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        new PagefindUI({ element: '#search', showImages: false });
      });
    </script>
  </body>
</html>
