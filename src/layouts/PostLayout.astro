---
const { frontmatter } = Astro.props;
const { title, date, category } = frontmatter;
const description = frontmatter.description ?? `${title} - ErrNotes の技術解決ログ`;

const path = Astro.url.pathname;
const slug = path.replace(/^\/posts\//, '').replace(/\/$/, '');
const enUrl = `/en/${slug}`;
const canonical = new URL(path, Astro.site).toString();
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - ErrNotes</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site).toString()} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="ErrNotes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {date && <meta property="article:published_time" content={String(date)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">Err<span>Notes</span></a>
        <nav class="site-nav">
          <a href="/">記事</a>
          <a href="/json-formatter">JSON</a>
          <a href="/base64">Base64</a>
          <a href="/regex-tester">RegEx</a>
          <span class="lang-switch">
            <a href="/" class="active">JA</a>
            <a href={enUrl}>EN</a>
          </span>
        </nav>
      </div>
    </header>
    <main class="site-wrapper">
      <article>
        <div class="article-header">
          <div class="category">{category}</div>
          <h1>{title}</h1>
          <div class="meta">{date}</div>
        </div>
        <div class="article-body">
          <slot />
        </div>
      </article>
    </main>
    <footer class="site-footer">
      <div class="site-wrapper">
        <a href="/about">このサイトについて</a>
        <span class="sep">·</span>
        <a href="/privacy">プライバシー</a>
        <span class="sep">·</span>
        <a href="https://bsky.app/profile/sasukkun.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>
        <span class="sep">·</span>
        <span>© {year} ErrNotes</span>
      </div>
    </footer>
  </body>
</html>
